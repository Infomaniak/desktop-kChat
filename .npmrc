//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
@infomaniak:registry=https://npm.pkg.github.com
registry=https://registry.npmjs.org
save-exact=true
engine-strict=true
# npm 12 gate: mmjstool is a DIRECT dep, SHA-pinned; a transitive git dep would fail loudly (EALLOWGIT) by design.
allow-git=root
min-release-age=7
# @infomaniak/* is first-party: new releases can be pinned within 7 days of publishing
min-release-age-exclude[]=@infomaniak/*
